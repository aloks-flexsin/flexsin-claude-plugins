# Central service configuration. Names only: never commit real values.
# Copy to .env for a local run, or set these in the Vercel project's environment variables.

# Random key, at least 32 characters (python -c "import secrets; print(secrets.token_hex(32))").
# The service refuses to start without it, and in production refuses a default or short key.
SECRET_KEY=

# sqlite:///path/to/central.db for a local run; postgres://... (Supabase connection string) in production.
DATABASE_URL=

# "production" turns on the production check (also on when Vercel sets VERCEL_ENV=production).
CENTRAL_ENV=

# The service's public https:// address; required in production.
PUBLIC_URL=
