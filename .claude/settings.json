{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git remote:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.auto/run/accounts.json)",
      "Bash(git tag:*)",
      "Bash(git tag)"
    ]
  },
  "extraKnownMarketplaces": {
    "flexsin-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "aloks-flexsin/flexsin-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "auto-runner@flexsin-claude-plugins": true
  }
}
