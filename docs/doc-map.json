{
  "entries": [
    {
      "name": "auto-runner modules",
      "paths": ["auto-runner/bin/*.py"],
      "docs": ["auto-runner/README.md"]
    },
    {
      "name": "auto-runner config",
      "paths": ["auto-runner/config.schema.json"],
      "docs": ["auto-runner/README.md"]
    },
    {
      "name": "auto-runner commands",
      "paths": ["auto-runner/commands/*.md"],
      "docs": ["auto-runner/README.md"]
    },
    {
      "name": "central service",
      "paths": ["auto-runner/central/**"],
      "docs": ["auto-runner/central/README.md"]
    }
  ]
}
